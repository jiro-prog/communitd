# Discord Developer Portal で作った Bot のトークン (SETUP.md 参照)。
# 変数名は config.policy.json の bots.<key>.tokenEnv と一致させる
# (config.policy.example.json の既定は manager / worker の 2 体)。
MANAGER_DISCORD_TOKEN=
WORKER_DISCORD_TOKEN=
# レビュー係の bot を足す場合のみ (config.policy.json の bots に reviewer を書いてから)
# REVIEWER_DISCORD_TOKEN=
